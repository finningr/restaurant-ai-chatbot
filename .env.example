OPENAI_API_KEY=your_api_key_here
NEXTAUTH_SECRET=your_secret_here

# URLs - to match production locally (invite links + emails use prod URL):
NEXTAUTH_URL=https://www.yourdomain.com
NEXT_PUBLIC_APP_URL=https://www.yourdomain.com

# For local-only dev (invite links point to localhost):
# NEXTAUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# Invite emails (Resend) - verify domain at resend.com/domains first
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Front of House <noreply@yourdomain.com>
